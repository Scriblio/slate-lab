{
  "name": "encore-karaoke",
  "version": "0.1.0",
  "private": true,
  "description": "A modern karaoke hosting app: rotation modes, YouTube + local library playback, and phone sign-ups.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/index.ts --dev",
    "demo": "vite build && tsx src/server/index.ts --demo",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:desktop": "vite build && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win nsis",
    "dist:store": "npm run build:desktop && electron-builder --win appx",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "dist:linux": "npm run build:desktop && electron-builder --linux AppImage",
    "icons": "electron scripts/make-icons.mjs",
    "build:sing": "node scripts/build-sing.mjs",
    "license:key": "node scripts/make-license-key.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@supabase/realtime-js": "^2.117.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sirv": "^3.0.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "main": "dist-desktop/main.mjs",
  "productName": "Encore Karaoke",
  "author": "Scriblio",
  "homepage": "https://scriblio.co"
}
